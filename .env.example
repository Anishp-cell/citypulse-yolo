# CityPulse configuration. Copy to .env for local development; set the same names as environment
# variables in production (see render.yaml). Only APP_ENV / DATABASE_URL are needed to run locally.

# dev | test | production  (production refuses unsafe settings)
APP_ENV=dev
APP_URL=http://localhost:8000
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local: leave unset to use SQLite (citypulse-dev.db). Production: Neon/Postgres URL.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Media storage: local (dev) | r2 (production, Cloudflare R2)
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=citypulse-public
R2_PRIVATE_BUCKET=citypulse-private
R2_PUBLIC_BASE_URL=

# Web push. Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Password-reset email (any SMTP provider, e.g. Brevo free tier). Unset = links are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for the daily job endpoint (GitHub Actions secret JOB_TOKEN uses the same value)
JOB_TOKEN=

# Optional
SENTRY_DSN=
LOCATIONIQ_KEY=
# nominatim | off
GEOCODER=nominatim
LOG_JSON=false
