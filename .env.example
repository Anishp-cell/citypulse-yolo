# ──────────────────────────────────────────────
# CityPulse — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# REQUIRED: Generate a strong random key
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/citypulse

# AI guidance (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Notifications ──────────────────────────────

# SendGrid (email alerts)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@your-domain.com
ALERT_EMAIL=emergency-contact@municipality.gov.in

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+1XXXXXXXXXX
ALERT_PHONE=+91XXXXXXXXXX

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank for localhost-only (development).
# Example: https://citypulse.ai,https://app.citypulse.ai
ALLOWED_ORIGINS=
